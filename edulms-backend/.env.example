# ==========================================================
# Edu-LMS Backend - Mẫu biến môi trường
# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG ghi thông tin thật (mật khẩu, secret, API key) vào file này.
# ==========================================================

PORT=5000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/<db_name>?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
NODE_ENV=development
SEED_PASSWORD=<seed_password>

# SonarCloud / CI (chỉ cấu hình trên CI secrets, không commit giá trị thật)
Project-key=<sonar_project_key>
Organization-key=<sonar_organization_key>
edulms-ci=<ci_token>

# Seed dữ liệu (PowerShell):
# cd edulms-backend
# $env:MONGODB_URI="mongodb+srv://<db_user>:<db_password>@<cluster_host>/<db_name>?retryWrites=true&w=majority"
# $env:SEED_PASSWORD="<seed_password>"
# npm run seed

# JWT Authentication Config
JWT_SECRET=<random_string_min_32_chars>
JWT_REFRESH_SECRET=<another_random_string_min_32_chars>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Storage Config
# Lấy tại: https://console.cloudinary.com -> Settings -> API Keys
# Thư mục lưu trữ (tự tạo khi upload):
#   edulms/documents     (raw)   PDF, DOC, DOCX, TXT, RTF
#   edulms/spreadsheets  (raw)   XLS, XLSX, CSV
#   edulms/presentations (raw)   PPT, PPTX
#   edulms/archives      (raw)   ZIP, RAR, 7Z
#   edulms/images        (image) JPG, JPEG, PNG, WEBP
#   edulms/videos        (video) MP4, MOV, WEBM
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
